# Copy to .env and adjust.

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public address of the app (used in invite links)
BASE_URL=https://phd.example.org
# true when served over HTTPS (production)
SECURE_COOKIES=true

# Your own Ollama server (normally on the same machine). Check the exact model name with `ollama list`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TIMEOUT=300
# Keep the model loaded between requests (cold starts can take minutes)
OLLAMA_KEEP_ALIVE=60m
# Optional: "false" turns off reasoning on models that support it (faster). Leave empty if unsure.
OLLAMA_THINK=

# Domain for Caddy's automatic HTTPS (docker compose only)
DOMAIN=phd.example.org

# Times shown in the app
TZ=Europe/Berlin
